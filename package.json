{
  "name": "workroom-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "tsc -p backend/tsconfig.build.json && next build",
    "build:backend": "tsc -p backend/tsconfig.build.json",
    "start": "next start",
    "backend": "tsx backend/src/server.ts",
    "check:backend": "tsc -p backend/tsconfig.json --noEmit",
    "test:backend": "tsx backend/tests/bootstrap.ts",
    "test:frontend": "tsx scripts/test-frontend.ts",
    "test": "tsx backend/tests/bootstrap.ts && tsx scripts/test-frontend.ts",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "format:fix": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc --noEmit",
    "validate": "pnpm run lint && pnpm run format && pnpm run typecheck"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "docxtemplater": "^3.71.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.474.0",
    "mammoth": "^1.12.3",
    "next": "15.5.18",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.3.0",
    "playwright-core": "^1.63.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "pnpm": {
    "overrides": {
      "picomatch": ">=2.3.2"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "postcss": "^8",
    "prettier": "3.4.2",
    "tailwindcss": "^3.4.1",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
