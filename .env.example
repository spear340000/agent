# Keep provider credentials in this local ignored file or a deployment secret manager.
NVIDIA_API_KEY=replace-with-your-provider-key
NVIDIA_BASE_URL=replace-with-your-provider-compatible-base-url
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Provision the corpus separately; keep it read-only.
LEGAL_RAG_ROOT=C:/path/to/legal-corpus

# Local defaults. Enable auth and set a strong token before remote exposure.
PORT=8787
API_AUTH_ENABLED=false
# API_AUTH_TOKEN=
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
