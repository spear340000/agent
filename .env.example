# Keep provider credentials in this local ignored file or a deployment secret manager.
NVIDIA_API_KEY=replace-with-your-provider-key
NVIDIA_BASE_URL=replace-with-your-provider-compatible-base-url
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Provision the corpus separately; keep it read-only.
LEGAL_DATA_ROOT=backend/legal/data
# For an existing read-only RAG checkout, set LEGAL_RAG_ROOT to its root directory.
# The root should contain data/, rag_mcp_server.py, and its Python environment.
# LEGAL_RAG_ROOT=../testA
# LEGAL_RUNTIME_ROOT=backend/legal
# LEGAL_PYTHON=backend/legal/.venv/Scripts/python.exe
# LEGAL_MCP_SCRIPT=backend/legal/rag_mcp_server.py

# Local defaults. Enable auth and set a strong token before remote exposure.
PORT=8787
API_AUTH_ENABLED=false
# API_AUTH_TOKEN=
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
